{
  "rest": {
    "RestGenerator": {
      "name": "ai-assist-techsupport",
      "uri": "http://localhost:8000/chat",
      "method": "post",
      "headers": {
        "Content-Type": "application/json"
      },
      "req_template_json_object": {
        "max_tokens": 300,
        "messages": [
          {
            "content": "$INPUT",
            "role": "user"
          }
        ],
        "temperature": 0.2
      },
      "response_json": true,
      "response_json_field": "content",
      "request_timeout": 60
    }
  }
}