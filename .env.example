# Имя приложения для логов и документации.
APP_NAME=

# Режим отладки FastAPI.
DEBUG=

# Список разрешенных источников CORS в JSON-формате.
CORS_ORIGINS=

# Адрес Redis для кеша ответов. Для Docker Compose используйте redis://redis:6379/0.
REDIS_URL=

# Пароль Redis. Для локального контейнера без авторизации оставьте пустым.
REDIS_PASSWORD=

# TTL кеша в секундах.
CACHE_TTL_SECONDS=

# Ключ OpenAI API. Можно использовать либо это поле, либо OPENAI_API_KEY.
LLM__OPENAI_API_KEY=

# Альтернативное имя переменной для ключа OpenAI API.
OPENAI_API_KEY=

# Модель по умолчанию для chat completions.
LLM__DEFAULT_MODEL=

# Таймаут запросов к OpenAI в секундах.
LLM__REQUEST_TIMEOUT=

# Количество повторных попыток на уровне SDK.
LLM__MAX_RETRIES=

# Включение Phoenix-трассировки: true/false. По умолчанию трассировка включена.
PHOENIX_TRACING_ENABLED=

# Адрес Phoenix Collector для отправки трейсов.
PHOENIX_COLLECTOR_ENDPOINT=

# Подключение к Postgres через asyncpg.
DATABASE_URL=postgresql+asyncpg://chat:chat@localhost:5432/chat

# Пароль контейнера Postgres для Docker Compose.
POSTGRES_PASSWORD=chat

# Какую реализацию репозитория использовать: json | postgres.
CHAT_REPOSITORY=json

# Куда писать JSONL-файлы при CHAT_REPOSITORY=json.
CHAT_STORAGE_DIR=./var/chats

# Стратегия контекста: sliding | hybrid.
CHAT_CONTEXT_STRATEGY=sliding

# Размер окна сообщений для контекста.
CHAT_CONTEXT_WINDOW=10

# Верхняя оценка размера контекстного окна в токенах.
CHAT_CONTEXT_WINDOW_TOKENS=8192

# Сколько токенов резервируем под ответ модели.
CHAT_RESPONSE_TOKENS=1024

# Дополнительный запас токенов на служебные накладные расходы.
CHAT_SAFETY_MARGIN=256

# Токен для Telegram бота
BOT_TOKEN=